# --- MongoDB -----------------------------------------------------------

# Учетные данные создаются docker-compose при первом запуске базы и входят
# в MONGODB_URI.
MONGO_INITDB_ROOT_USERNAME=reviews
MONGO_INITDB_ROOT_PASSWORD=change-me

# Порт базы на хосте при локальной разработке.
MONGO_PORT=27017

# Адрес базы для служб. В контейнерах его задает docker-compose.
MONGODB_URI=mongodb://reviews:change-me@localhost:27017/reviews?authSource=admin

# --- Секреты -----------------------------------------------------------

# Ключ шифрования токенов агрегатора: ровно 32 байта в base64. Без него
# токены легли бы в базу открытым текстом. Сгенерировать:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Секрет подписи JWT консоли управления, не короче 16 символов.
# Сгенерировать так же, как ключ выше.
JWT_SECRET=

# --- Службы ------------------------------------------------------------

# Порты служб. Общего PORT нет намеренно: иначе API консоли и API виджета
# заняли бы один и тот же порт. Обработчику синхронизации порт не нужен: он
# запросов не принимает. В контейнерах служба слушает этот же порт и на нем
# публикуется.
CONSOLE_API_PORT=3010
WIDGET_API_PORT=3011

# Базовый адрес API агрегатора отзывов.
AGGREGATOR_BASE_URL=https://myreviews.dev

# Адрес скрипта виджета: подставляется в код вставки, который консоль выдает
# клиенту. В разработке это модуль дев-сервера виджета. В боевой среде это
# собранный файл на его поддомене.
WIDGET_SCRIPT_URL=http://localhost:5173/src/reviews-widget.ts

# --- Развертывание -----------------------------------------------------

# Адреса API вшиваются в бандлы консоли и виджета при сборке. Здесь заданы
# локальные значения для разработки; боевые передаются аргументами сборки
# образа (см. Dockerfile), а файл .env в образ не копируется.
VITE_CONSOLE_API_URL=http://localhost:3010
VITE_WIDGET_API_URL=http://localhost:3011
